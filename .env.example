# ============================================================================
# 北极星 · 社媒增长 Agent 平台 —— 环境变量示例
# ============================================================================
# 用法：
#   1) 复制本文件为 .env ：  cp .env.example .env   （Windows: copy .env.example .env）
#   2) 按需填真实值（所有项都有安全的默认值，只有 DSH_JS 是必须填的）
#   3) 加载到当前 shell：
#        - Mac / Linux (bash/zsh):  set -a; source .env; set +a
#        - Windows PowerShell:      把下面的 KEY=VALUE 用 $env:KEY="VALUE" 设置
#   4) 或使用 Node 自带 --env-file（Node >= 18.19 或 >= 20.6）：
#        cd shell && node --env-file=../.env server.cjs
#
# 说明：所有值都是占位符 / 演示默认值，不含任何真实密钥。生产环境请务必替换。
# ============================================================================

# ----------------------------------------------------------------------------
# 一、业务壳（shell/）
# ----------------------------------------------------------------------------

# 业务壳对外端口（默认 8098；文档里也称 PORT）
PT_SHELL_PORT=8098

# 业务壳监听地址（默认 127.0.0.1；部署到容器/反代后如需对外改 0.0.0.0）
PT_LISTEN_HOST=127.0.0.1

# 默认管理员账号（首个账号；留空则用 admin）
PT_SHELL_USER=admin

# 默认管理员密码（管理密码）
# 留空 = 启动时生成一个随机密码并打印一次（仅本次启动可见，务必记下）
# 非 127.0.0.1 监听时若未显式设置密码，服务会直接拒绝启动（防裸奔）
PT_SHELL_PASSWORD=

# 身份库（PGlite）落盘目录（默认 repo 根/db；相对路径按 repo 根解析）
PT_DB_DIR=

# master key 文件路径（默认 repo 根/secrets/master.key）
# Windows 下走 DPAPI 加密；Mac/Linux 下为随机 key 文件（权限 0600，勿提交）
PT_MASTER_KEY_FILE=

# 日志目录（默认 repo 根/logs）
PT_LOG_DIR=

# 会话有效期（毫秒；默认 7 天）
PT_SESSION_TTL_MS=

# PGlite 入口显式指定（默认自动在 shell/node_modules 里找，一般不用设）
PT_PGLITE_PATH=

# 会话 Cookie 是否加 Secure 标记（HTTPS 生产模式设 1；本地 HTTP 保持空）
# 设 1 时还会对所有响应加 HSTS 头
PT_COOKIE_SECURE=

# 上传图片每租户磁盘配额（MB，默认 100）
PT_UPLOAD_QUOTA_MB=

# ----------------------------------------------------------------------------
# 二、DSH 入口（必需）—— 找不到 DSH 时对话会失败
# ----------------------------------------------------------------------------

# DSH 的 JS 入口（@deepseek-ai/dsh/lib/bin.js 的绝对路径）
# 不设时会自动在 node_modules / 全局 npm root 里找；找不到请设这个。
# 示例（Mac/Linux）: /usr/local/lib/node_modules/@deepseek-ai/dsh/lib/bin.js
# 示例（Windows）:   C:\\Users\\you\\.workbuddy\\binaries\\node\\workspace\\node_modules\\@deepseek-ai\\dsh\\lib\\bin.js
DSH_JS=

# ----------------------------------------------------------------------------
# 三、看板后端（analytics/）与业务壳对接
# ----------------------------------------------------------------------------

# 看板后端端口（默认 8095）
PT_DASH_PORT=8095

# 看板只读 token（业务壳与看板后端必须一致；文档里也称 DASH_TOKEN）
# 无默认值：不设时看板后端拒绝启动，业务壳 /api/analytics/* 反代会返回「未配置」。
# 请设一个随机长串（例如 openssl rand -hex 32）；改了之后看板后端要 --reseed 重新灌数据。
PT_DASH_TOKEN=

# 看板后端打点 webhook 签名密钥（analytics/ 用；无默认值，缺失拒绝启动）
PT_DASH_WEBHOOK_SECRET=

# 看板后端数据目录（默认 analytics/.pgdata）
PT_DASH_DATA_DIR=

# 看板租户透传：业务壳把已登录租户以 X-Tenant-Id 头透传给看板（需两端同时开启）
# 业务壳侧开关；看板后端侧对应 TRUST_TENANT_HEADER
PT_DASH_TENANT_INJECT=

# 是否信任反代透传的真实来源 IP（1=开；默认关，仅信 socket，防伪造）
# 仅在 nginx 与本应用同机/可信网络且 nginx 是唯一入口时才开
TRUST_PROXY=

# 看板后端侧：是否信任业务壳透传的 X-Tenant-Id 租户头（配合上面的租户透传）
TRUST_TENANT_HEADER=

# ----------------------------------------------------------------------------
# 四、PT key（BYOK）有效性校验
# ----------------------------------------------------------------------------

# PowerTokens 校验端点基址（默认 https://api.powertokens.ai/v1）
PT_KEY_VERIFY_BASEURL=

# 保存 key 前是否做 live 有效性校验（默认 1=开；设 0 退化为仅本地格式校验）
PT_KEY_LIVE_VERIFY=1

# live 校验超时（毫秒；默认 8000）
PT_KEY_VERIFY_TIMEOUT_MS=

# ----------------------------------------------------------------------------
# 五、对话 / 限流 / 防爆破（一般用默认即可）
# ----------------------------------------------------------------------------

# 对话 dry-run 开关：设 1 时 /api/chat 不真正 spawn DSH，只回注入 key 的 sha256
# 仅用于联调/冒烟测试，生产必须保持关闭
PT_CHAT_DRYRUN=

# /api/chat 每 IP 每分钟限流次数（默认 20）
PT_RATE_CHAT_PER_MIN=

# 登录 / 注册限流与登录防爆破阈值（默认值已写死，可覆盖）
PT_RATE_LOGIN_PER_MIN=
PT_RATE_REGISTER_PER_MIN=
PT_BF_MAX_FAILURES=
PT_BF_WINDOW_MS=
PT_BF_LOCK_MS=
