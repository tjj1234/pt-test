{
  "$id": "attribution.canonical-ad.v1.1",
  "title": "CanonicalAdRecord",
  "description": "Google / Meta / X 导出文件经 Provider Parser 归一后的广告日指标行。v1.1 相对 v1 向后兼容：仅新增可选字段 country，不改动任何必填字段。A1+ 须产出本结构再写入。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workspaceId",
    "provider",
    "accountId",
    "campaignId",
    "creativeId",
    "date",
    "currency",
    "spend",
    "impressions",
    "clicks",
    "rawSource",
    "importedAt",
    "sourceFileId",
    "sourceRowNumber",
    "sourceProvider",
    "sourceVersion"
  ],
  "properties": {
    "workspaceId": { "type": "string", "minLength": 1 },
    "provider": { "type": "string", "enum": ["google", "meta", "x"] },
    "accountId": { "type": "string", "minLength": 1 },
    "campaignId": { "type": "string", "minLength": 1 },
    "adGroupId": { "type": ["string", "null"] },
    "creativeId": { "type": "string", "minLength": 1 },
    "creativeName": { "type": ["string", "null"] },
    "campaignName": { "type": ["string", "null"] },
    "country": {
      "type": ["string", "null"],
      "description": "v1.1 新增（可选、向后兼容）。国家/地区，来自导出列或 Location sheet join。"
    },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "currency": { "type": "string", "minLength": 3, "maxLength": 3 },
    "spend": { "type": "number", "minimum": 0 },
    "impressions": { "type": "integer", "minimum": 0 },
    "clicks": { "type": "integer", "minimum": 0 },
    "conversions": { "type": ["number", "null"], "minimum": 0 },
    "revenue": { "type": ["number", "null"], "minimum": 0 },
    "rawSource": {
      "type": "string",
      "enum": ["csv_export", "xlsx_export"],
      "description": "一期仅导出文件；禁止 official_api"
    },
    "importedAt": { "type": "string", "format": "date-time" },
    "sourceFileId": { "type": "string", "minLength": 1 },
    "sourceRowNumber": { "type": "integer", "minimum": 1 },
    "sourceProvider": { "type": "string", "enum": ["google", "meta", "x"] },
    "sourceVersion": {
      "type": "string",
      "minLength": 1,
      "description": "契约版本标记。含 country 的解析器应写 a1.1（或更高）；旧 a1.0 记录仍合法（country 缺省为 null）。"
    }
  }
}
