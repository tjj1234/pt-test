# ============================================================================
# 北极星 · 社媒增长 Agent 平台 —— .gitignore
# ============================================================================

# ---- 依赖（各自 npm install，绝不上传）----
node_modules/

# ---- 环境变量 / 敏感信息（绝不提交真实值）----
.env
.env.local
.env.*.local

# ---- 运行时数据（数据库 / 密钥 / 日志，全部本地生成）----
db/
secrets/
logs/
runtime/

# 看板后端 PGlite 数据目录（含 *.pgdata* 各种临时/恢复目录）
.pgdata*
*.pgdata*

# ---- 日志 / 临时文件 ----
*.log
*.tmp
*.bak
*.bak-*

# ---- 锁文件 / 进程残留 ----
*.lock
.delivery-*.lock
.delivery-url*.txt

# ---- 各类自测 / 探针 / 验收临时文件 ----
_probe*
_smoke*
_自测*
_验收*
自测-*
验收-*
_accept*
_verify*
查库.*
清理临时文件.*

# ---- 系统 / 编辑器 ----
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
