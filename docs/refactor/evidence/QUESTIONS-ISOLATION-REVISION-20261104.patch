+import fs from 'node:fs';import os from 'node:os';import path from 'node:path';import assert from 'node:assert/strict';import {createRequire} from 'node:module';import crypto from 'node:crypto';
+const require=createRequire(import.meta.url);const {createQuestionManager}=require('../../shell/candidates/questions-20261103/index.cjs');const {createControlledExecutor,sha256}=require('../../shell/candidates/isolation-20261103/index.cjs');
+const rows=[];const identity={runId:'fixture-run',tenantId:'fixture-tenant',userId:'owner'};const respondent={respondentUserId:'owner',respondentTenantId:'fixture-tenant'};
+async function check(id,fn){try{await fn();rows.push({id,status:'PASS'});console.log('PASS '+id);}catch(e){rows.push({id,status:'FAIL',error:e.message});console.log('FAIL '+id);}}
+function manager(){return createQuestionManager(identity)}
+const target={displayedToUser:true,operationType:'run-script',operationPayload:{script:'console.log(1)'}};
+await check('Q-OPTIONS',async()=>{const q=manager();const p=q.askQuestion('id',{type:'approval',question:'Approve?',approvalTarget:target,timeoutMs:1000});p.catch(()=>{});const r=q.submitAnswer('id','ARBITRARY',respondent);q.cancelPendingQuestions(identity.runId);await Promise.allSettled([p]);assert.equal(r.ok,false,'approval without required options accepted arbitrary answer');});
+await check('Q-ID-CONFLICT',async()=>{const q=manager();const a=q.askQuestion('id',{type:'approval',question:'Approve one?',options:['YES','NO'],approvalTarget:target,timeoutMs:1000});a.catch(()=>{});const b=q.askQuestion('id',{type:'approval',question:'Approve another?',options:['YES','NO'],approvalTarget:{...target,operationPayload:{script:'different'}},timeoutMs:1000});b.catch(()=>{});const same=a===b;q.cancelPendingQuestions(identity.runId);await Promise.allSettled([a,b]);assert.equal(same,false,'same questionId reused with different target returns old approval promise');});
+await check('Q-DEADLINE',async()=>{const q=manager();const p=q.askQuestion('id',{type:'approval',question:'Approve?',options:['YES'],approvalTarget:target,timeoutMs:5});p.catch(()=>{});const end=Date.now()+20;while(Date.now()<end){}const r=q.submitAnswer('id','YES',respondent);q.cancelPendingQuestions(identity.runId);await Promise.allSettled([p]);assert.equal(r.ok,false,'deadline passed but event-loop timer not yet run; late answer accepted');});
+await check('Q-OPTIONS-MUTATION',async()=>{const q=manager();const options=['NO'];const p=q.askQuestion('id',{type:'approval',question:'Approve?',options,approvalTarget:target,timeoutMs:1000});p.catch(()=>{});options.push('YES');const r=q.submitAnswer('id','YES',respondent);q.cancelPendingQuestions(identity.runId);await Promise.allSettled([p]);assert.equal(r.ok,false,'caller mutated displayed options after question creation');});
+const tmp=fs.mkdtempSync(path.join(os.tmpdir(),'pt-05-06-review-'));const allowed=path.join(tmp,'allowed');fs.mkdirSync(allowed);const outside=path.join(tmp,'outside');fs.mkdirSync(outside);fs.writeFileSync(path.join(outside,'fixture.txt'),'SYNTHETIC_OUTSIDE_ONLY');const executor=createControlledExecutor({allowedPaths:[allowed]});
+try{
+ await check('I-PARENT-LINK',async()=>{fs.symlinkSync(outside,path.join(allowed,'jump'));const r=await executor.controlledExec({...identity,execType:'read-file',input:{path:path.join(allowed,'jump','fixture.txt')}});assert.equal(r.ok,false,'parent symlink escaped allowed root and read synthetic outside data');});
+ await check('I-HARDLINK',async()=>{fs.linkSync(path.join(outside,'fixture.txt'),path.join(allowed,'alias.txt'));const r=await executor.controlledExec({...identity,execType:'read-file',input:{path:path.join(allowed,'alias.txt')}});assert.equal(r.ok,false,'hardlink alias accepted although contract rejects hardlinks');});
+ await check('I-FORGED-APPROVAL',async()=>{const script='console.log("HARMLESS_FIXTURE")';const r=await executor.controlledExec({...identity,execType:'run-script',input:{script},approvalToken:{questionId:'never-issued',operationType:'run-script',operationPayloadHash:sha256(script)}});assert.equal(r.ok,false,'self-constructed hash token accepted without issued approval or real sandbox backend');});
+ await check('I-SCRIPT-ROOT',async()=>{const script='console.log(require("node:fs").readFileSync('+JSON.stringify(path.join(outside,'fixture.txt'))+',"utf8"))';const r=await executor.controlledExec({...identity,execType:'run-script',input:{script},approvalToken:{questionId:'never-issued',operationType:'run-script',operationPayloadHash:sha256(script)}});assert.equal(r.ok,false,'bare host node script read synthetic data outside allowedPaths');});
+}finally{fs.rmSync(tmp,{recursive:true,force:true})}
+const sourcePaths=['shell/candidates/questions-20261103/index.cjs','shell/candidates/isolation-20261103/index.cjs'];const sources=Object.fromEntries(sourcePaths.map(p=>[p,crypto.createHash('sha256').update(fs.readFileSync(p)).digest('hex')]));const report={time_utc:new Date().toISOString(),scope:'Actual candidates; isolated synthetic temp files and harmless child scripts only; no provider/network/production access',sources,total:rows.length,passed:rows.filter(x=>x.status==='PASS').length,failed:rows.filter(x=>x.status==='FAIL').length,results:rows};fs.writeFileSync('docs/refactor/evidence/QUESTIONS-ISOLATION-MAIN-REVIEW-20261104.json',JSON.stringify(report,null,2)+'\n');console.log(JSON.stringify({total:report.total,passed:report.passed,failed:report.failed}));if(report.failed)process.exitCode=1;
