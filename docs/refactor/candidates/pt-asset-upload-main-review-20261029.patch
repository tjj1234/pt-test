+def recover_uploaded_asset_for_product(task_id, hooks=None, transport=None, clock=None,
+                                       sleep=None, cancel_token=None, poll_timeout=120):
+    """GET-only recovery of an already persisted task; never submits bytes."""
+    if not isinstance(task_id, str) or not _ASSET_TASK_ID_RE.fullmatch(task_id):
+        return _make_asset_result("not_submitted", False, None, None, "INVALID_TASK_ID", False, 0, "")
+    if type(poll_timeout) not in (int, float) or not math.isfinite(poll_timeout) or not 0 < poll_timeout <= 120:
+        return _make_asset_result("not_submitted", False, task_id, None, "INVALID_TIMEOUT", True, 0, "")
+    hooks = hooks if hooks is not None else {}
+    if not isinstance(hooks, dict) or set(hooks) - {"on_asset_id"} or any(not callable(v) for v in hooks.values()):
+        return _make_asset_result("not_submitted", False, task_id, None, "INVALID_HOOKS", True, 0, "")
+    clock = clock or time.monotonic
+    sleep = sleep or time.sleep
+    def cancelled():
+        if cancel_token is None:
+            return False
+        try:
+            if callable(cancel_token):
+                return bool(cancel_token())
+            value = cancel_token.is_cancelled
+            return bool(value() if callable(value) else value)
+        except Exception:
+            return True
+    def do_request(request, timeout):
+        if request.get_method() != "GET":
+            raise ValueError("Recovery cannot submit")
+        if transport is not None:
+            if hasattr(transport, "open"):
+                return transport.open(request, timeout=timeout)
+            if callable(transport):
+                return transport(request, timeout=timeout)
+            raise ValueError("Invalid recovery transport")
+        return _ASSET_NO_REDIRECT_OPENER.open(request, timeout=timeout)
+    return _poll_uploaded_asset(task_id, hooks, do_request, clock, sleep, cancelled,
+                                clock() + poll_timeout)
+
+
