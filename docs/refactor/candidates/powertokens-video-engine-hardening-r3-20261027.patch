+def is_agreement_error(e):
+    """提交返回的错误是否因 Seedance 协议未签导致（用于报错回退重置标记）。
+    注意：PT 已确认不能细分‘素材未入库’和‘内容违规’；
+    naked 'asset library'（如 'asset library content rejected' 或 'asset library design rejected'）
+    不能因 'design' 含有 'sign' 子串就误判为协议未签！
+    只有明确全词匹配协议/未签/agreement 时才判定为协议未签。
+    """
+    m = (getattr(e, "message", "") or "").lower()
+    if _SIGN_WORD_RE.search(m):
+        return True
+    if "asset library" in m:
+        # Check strict agreement markers, guarding against 'design' containing 'sign'
+        if "design" in m and "agreement" not in m:
+            return False
+        return any(k in m for k in ("user agreement", "sign the agreement", "agreement required", "agreement not signed", "未签", "协议"))
+    return any(k in m for k in ("user agreement", "sign the agreement", "agreement required", "未签协议", "未签署"))
+
