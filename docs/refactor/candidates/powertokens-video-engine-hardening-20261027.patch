+def _validate_product_request(request, api_key):
+    """Validate ProductRequest before any network call. Raises ValueError on bad input."""
+    if not api_key or not isinstance(api_key, str) or not api_key.strip():
+        raise ValueError("api_key must be a non-empty string; no fallback to env or config")
+    if not request.model or not isinstance(request.model, str):
+        raise ValueError("model must be a non-empty string")
+    if len(request.model) > _MAX_MODEL_ID_LEN:
+        raise ValueError(f"model ID too long (max {_MAX_MODEL_ID_LEN} chars)")
+    if request.kind not in _ALLOWED_KINDS:
+        raise ValueError(f"kind must be one of {sorted(_ALLOWED_KINDS)}, got {request.kind!r}")
+    # Guard against auto/config model fallback
+    if request.model.lower() == "auto":
+        raise ValueError("model='auto' not allowed in product API; caller must supply exact model ID")
+    # Numeric guards
+    for name, val, lo, hi in [
+        ("duration", request.duration, _MIN_DURATION, _MAX_DURATION),
+        ("n", request.n, 1, _MAX_N_IMAGES),
+        ("poll_timeout", request.poll_timeout, 10, 7200),
+        ("submit_timeout", request.submit_timeout, 10, 600),
+        ("poll_interval", request.poll_interval, 1, 120),
+    ]:
+        if not isinstance(val, (int, float)) or not math.isfinite(val):
+            raise ValueError(f"{name} must be a finite number, got {val!r}")
+        if not (lo <= val <= hi):
+            raise ValueError(f"{name} must be in [{lo}, {hi}], got {val!r}")
+    if request.kind in ("video", "seedance"):
+        if request.resolution.upper() not in {r.upper() for r in _ALLOWED_RESOLUTIONS}:
+            raise ValueError(f"resolution must be one of {sorted(_ALLOWED_RESOLUTIONS)}")
+        if request.ratio not in _ALLOWED_RATIOS:
+            raise ValueError(f"ratio must be one of {sorted(_ALLOWED_RATIOS)}")
+    if request.kind == "image":
+        if request.aspect_ratio not in _ALLOWED_ASPECT_RATIOS:
+            raise ValueError(f"aspect_ratio must be one of {sorted(_ALLOWED_ASPECT_RATIOS)}")
+    if request.prompt and len(request.prompt) > _MAX_PROMPT_LEN:
+        raise ValueError(f"prompt too long (max {_MAX_PROMPT_LEN} chars)")
+    if request.kind == "image" and request.model.lower() == "image-01" and request.first_frame:
+        # image2image not implemented; guard against silent wrong submission
+        raise ValueError(
+            "image-01 subject_reference (image2image) is not implemented in this engine. "
+            "Only text2image is supported. image2image: unsupported."
+        )
+    # Seedance: http media must not be passed; only asset:// allowed
+    if request.kind == "seedance":
+        for url in ([request.first_frame, request.last_frame] + list(request.ref_images or [])):
+            if url and url.startswith("http"):
+                raise ValueError(
+                    f"Seedance media URL must use asset:// format (upload first with `upload` command). "
+                    f"http(s) URLs are rejected by PT for Seedance."
+                )
+    # Asset URL length guard
+    for url in ([request.first_frame, request.last_frame] + list(request.ref_images or [])):
+        if url and len(url) > _MAX_ASSET_URL_LEN:
+            raise ValueError(f"Media URL too long (max {_MAX_ASSET_URL_LEN} chars)")
+
