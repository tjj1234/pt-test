+class ProductHooks:
+    """Optional hooks injected into generate_for_product.
+    All hooks are called synchronously. If a hook raises, the contract is:
+      - before_submit: exception prevents any POST (0 charges)
+      - on_task_id:    exception raises TaskIdWriteError (task_id preserved); polling stops
+      - on_result:     exception is logged but does NOT trigger re-submission
+    """
+    def before_submit(self, metadata: dict) -> None:
+        """Called before any billable POST. metadata: model, kind, endpoint, billing_params only."""
+    def on_task_id(self, task_id: str) -> None:
+        """Called immediately after receiving task_id, before first poll."""
+    def on_result(self, result: ProductResult) -> None:
+        """Called with final result; failure here must not re-submit."""
+
+
+class TaskIdWriteError(Exception):
+    """Raised when on_task_id hook fails. task_id is preserved in .task_id."""
+    def __init__(self, task_id, cause):
+        self.task_id = task_id
+        self.cause = cause
+        super().__init__(f"on_task_id hook failed for task_id={task_id}: {cause}")
+
+
+def generate_for_product(request: ProductRequest, *, api_key: str,
+                         hooks: ProductHooks = None,
+                         _transport=None, _sleep=None, _clock=None,
+                         _cancel: CancellationToken = None) -> ProductResult:
+    """
+    Stable product API entry point for the Northstar host.
+
+    Contract:
+    - api_key MUST be supplied explicitly; never falls back to env/config
+    - model MUST be an exact, whitelisted model ID (no 'auto')
+    - kind MUST be one of: image | video | seedance
+    - No file download; result_urls returned for host asset-ingest handler
+    - POST submitted at most once; timeout/cancel sets unknown/reconciliation state
+    - billing_params reflects request parameters; cost_usd always null (use F3)
+    - error_code is stable; raw upstream body never echoed
+    - image2image (image-01 subject_reference): explicitly unsupported
+    """
+    hooks = hooks or ProductHooks()
+    _cancel = _cancel or _NOT_CANCELLED
+    _clock = _clock or time.time
+    _sleep = _sleep or time.sleep
+
+    # ---- validate ----
+    try:
+        _validate_product_request(request, api_key)
+    except ValueError as e:
+        return ProductResult(ok=False, error_code="INVALID_REQUEST",
+                             error_hint=str(e), kind=request.kind, model=request.model)
+
+    billing_params = {
+        "model": request.model,
+        "kind": request.kind,
+        "duration_s": request.duration if request.kind != "image" else None,
+        "resolution": request.resolution if request.kind != "image" else None,
+        "n_images": request.n if request.kind == "image" else None,
+        "aspect_ratio": request.aspect_ratio if request.kind == "image" else None,
+    }
+
+    # ---- before_submit hook (must fire before ANY billable POST) ----
+    meta = {
+        "model": request.model,
+        "kind": request.kind,
+        "endpoint": IMAGE_ENDPOINT if request.kind == "image" else VIDEO_SUBMIT,
+        "billing_params": billing_params,
+    }
+    try:
+        hooks.before_submit(meta)
+    except Exception as e:
+        return ProductResult(ok=False, error_code="BEFORE_SUBMIT_REJECTED",
+                             error_hint=f"before_submit hook rejected: {type(e).__name__}",
+                             model=request.model, kind=request.kind)
+
+    # ---- check cancellation before submit ----
+    if _cancel.is_cancelled:
+        return ProductResult(ok=False, error_code="CANCELLED_BEFORE_SUBMIT",
+                             error_hint="Cancelled before submit; 0 charges",
+                             model=request.model, kind=request.kind)
+
+    # ---- build _transport wrapper ----
+    def _do_call(method, path, key, timeout):
+        fn = _transport or _api_call
+        if _transport:
+            return _transport(method, path, key, timeout)
+        return _api_call(method, path, key, body=None, timeout=timeout)
+
+    # ============================================================
+    # IMAGE path (synchronous)
+    # ============================================================
+    if request.kind == "image":
+        body = {
+            "model": request.model,
+            "prompt": request.prompt or "",
+            "aspect_ratio": request.aspect_ratio,
+            "n": request.n,
+        }
+        if request.seed is not None:
+            body["seed"] = request.seed
+        try:
+            if _transport:
+                resp = _transport("POST", IMAGE_ENDPOINT, api_key, request.submit_timeout)
+            else:
+                resp = _api_call("POST", IMAGE_ENDPOINT, api_key,
+                                 body=body, timeout=request.submit_timeout)
+        except ApiError as e:
+            code, hint = classify_error(e)
+            return ProductResult(ok=False, error_code=code, error_hint=hint,
+                                 model=request.model, kind="image")
+        data = resp.get("data") or []
+        urls = [it.get("url") for it in data if isinstance(it, dict) and it.get("url")]
+        if not urls:
+            return ProductResult(ok=False, error_code="IMAGE_RESULT_EMPTY",
+                                 error_hint="HTTP 200 but no result URLs in data[].url; cannot return ok:true",
+                                 model=request.model, kind="image")
+        result = ProductResult(ok=True, model=request.model, kind="image",
+                               status="completed", result_urls=urls,
+                               billing_params=billing_params)
+        try:
+            hooks.on_result(result)
+        except Exception:
+            pass  # on_result failure must not re-submit
+        return result
+
+    # ============================================================
+    # VIDEO / SEEDANCE path (async: POST then poll)
+    # ============================================================
+    force_asset = (request.kind == "seedance")
+
+    # Build media list
+    media = []
+    if request.first_frame:
+        media.append({"type": "first_frame", "url": request.first_frame})
+    if request.last_frame:
+        media.append({"type": "last_frame", "url": request.last_frame})
+    for u in (request.ref_images or []):
+        media.append({"type": "reference_image", "url": u})
+
+    if force_asset:
+        text_part = {"type": "text", "text": request.prompt or ""}
+        body_media = [text_part] + media if media else [text_part]
+        body = {
+            "model": request.model,
+            "media": body_media,
+            "size": request.resolution.upper(),
+            "ratio": request.ratio,
+            "seconds": str(request.duration),
+            "generate_audio": not request.no_audio,
+            "prompt_extend": not request.no_prompt_extend,
+            "watermark": request.watermark,
+        }
+    else:
+        body = {
+            "model": request.model,
+            "prompt": request.prompt or "",
+            "size": request.resolution.upper(),
+            "ratio": request.ratio,
+            "seconds": str(request.duration),
+            "generate_audio": not request.no_audio,
+            "prompt_extend": not request.no_prompt_extend,
+            "watermark": request.watermark,
+        }
+        if media:
+            body["media"] = media
+    if request.seed is not None:
+        body["seed"] = request.seed
+
+    # Submit — exactly once
+    task_id = None
+    try:
+        if _transport:
+            resp = _transport("POST", VIDEO_SUBMIT, api_key, request.submit_timeout)
+        else:
+            resp = _api_call("POST", VIDEO_SUBMIT, api_key, body=body,
+                             timeout=request.submit_timeout)
+        task_id = resp.get("id") or resp.get("task_id")
+        if not task_id:
+            return ProductResult(ok=False, error_code="SUBMIT_NO_TASK_ID",
+                                 error_hint="Submit returned HTTP 200 but no task_id; result unknown. DO NOT resubmit.",
+                                 model=request.model, kind=request.kind)
+    except ApiError as e:
+        code, hint = classify_error(e)
+        return ProductResult(ok=False, error_code=code, error_hint=hint,
+                             model=request.model, kind=request.kind)
+
+    # on_task_id hook — must fire BEFORE first poll; failure stops here (id preserved)
+    try:
+        hooks.on_task_id(task_id)
+    except Exception as e:
+        raise TaskIdWriteError(task_id, e)
+
+    # Poll
+    try:
+        task = poll_task(api_key, task_id,
+                         interval=request.poll_interval,
+                         timeout=request.poll_timeout,
+                         _transport=_transport,
+                         _sleep=_sleep,
+                         _clock=_clock,
+                         _cancel=_cancel)
+    except ApiError as e:
+        msg = str(getattr(e, "message", e))
+        if "取消" in msg or "Cancelled" in msg.lower():
+            return ProductResult(ok=False, error_code="CANCELLED_DURING_POLL",
+                                 error_hint=f"Cancelled; task_id={task_id} retained for reconciliation",
+                                 task_id=task_id, model=request.model, kind=request.kind,
+                                 status="unknown_cancelled")
+        if "超时" in msg or "timeout" in msg.lower():
+            return ProductResult(ok=False, error_code="POLL_TIMEOUT",
+                                 error_hint=f"Local poll timeout; task_id={task_id} retained. "
+                                             f"DO NOT resubmit; check status manually.",
+                                 task_id=task_id, model=request.model, kind=request.kind,
+                                 status="unknown_timeout")
+        code, hint = classify_error(e)
+        return ProductResult(ok=False, error_code=code, error_hint=hint,
+                             task_id=task_id, model=request.model, kind=request.kind)
+
+    url = result_url(task)
+    if not url:
+        return ProductResult(ok=False, error_code="VIDEO_RESULT_EMPTY",
+                             error_hint="Task succeeded but result URL absent; cannot return ok:true",
+                             task_id=task_id, model=request.model, kind=request.kind)
+
+    result = ProductResult(ok=True, task_id=task_id, model=request.model,
+                           kind=request.kind, status="completed",
+                           result_urls=[url], billing_params=billing_params)
+    try:
+        hooks.on_result(result)
+    except Exception:
+        pass  # on_result failure must not re-submit
+    return result
+
+
 def cmd_generate(argv):
     parser = argparse.ArgumentParser(prog="pt_video.py generate")
     parser.add_argument("-m", "--model", default=None, help="模型 ID；省略或 auto = 按账号自动选")
