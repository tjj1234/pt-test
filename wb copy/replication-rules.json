{
  "schema_version": 1,
  "product": "WorkBuddy",
  "target": "复刻同类 Agent（Web 版）",
  "sources": [
    "codebuddy.js (22MB webpack bundle, 22955544 chars)",
    "~/.workbuddy 运行时数据（会话 JSONL / file-history / trace）",
    "~/.codebuddy 运行时数据（skills / 记忆）",
    "tencent-docx 内置插件源码（app-extracted/resources/plugins/workbuddy-builtin/builtin-plugins/tencent-docx/）"
  ],
  "batches": [
    {
      "id": "01",
      "file": "01-agent-core.md",
      "title": "Agent 循环引擎 + 工具系统 + 会话格式",
      "modules": ["Runner/RunState", "BaseTool", "ToolPermissionService", "MCP Proxy", "SessionStore", "CheckpointService", "rewind/compaction"]
    },
    {
      "id": "02",
      "file": "02-permissions-sandbox.md",
      "title": "权限分级 + 沙箱（风险隔离）",
      "modules": ["PermissionMode", "CommandUtils", "SandboxOrchestrator", "classifySafety", "AutoModeClassifier", "DenialTracker", "审计日志", "沙箱后端"]
    },
    {
      "id": "03",
      "file": "03-model-memory-skills.md",
      "title": "模型调度 + 记忆架构 + 技能系统",
      "modules": ["resolveModel/computeRelatedModel", "MemoryManager/Loader", "Agent 持久记忆", "相关记忆/提取", "技能扫描/解析", "skill_manage"]
    },
    {
      "id": "04",
      "file": "04-docpipeline-automation.md",
      "title": "文档管线 + 自动化调度（Cron）",
      "modules": ["tdoc-orchestrator", "doc-writer/formatter/converter", "溯源协议", "Cron 解析器", "CronStateManager/CronStorage", "createCronScheduler", "CronSchedulerService", "/loop"]
    }
  ],

  "constants": {
    "agent_core": {
      "default_max_turns": 10,
      "session_max_items": 1000,
      "session_max_items_env": "CODEBUDDY_SESSION_MAX_ITEMS",
      "read_buffer_bytes": 65536
    },
    "permissions_sandbox": {
      "circuit_breaker_threshold": 5,
      "max_consecutive_denials": 3,
      "max_total_denials": 20,
      "recent_denials_max": 20,
      "stage1_max_tokens": 256,
      "stage2_max_tokens": 8192,
      "reserved_tokens": 2048,
      "stage1_timeout_ms": 60000,
      "stage2_timeout_ms": 120000,
      "stop_sequences": ["</block>"],
      "audit_dir_name": "audit-log",
      "spool_dir_name": "spool",
      "preview_max": 1024,
      "audit_env": "CODEBUDDY_ENABLE_SECURITY_AUDIT"
    },
    "memory": {
      "max_memory_file_size": 40000,
      "max_memory_entrypoint_lines": 200,
      "max_memory_entrypoint_bytes": 25000,
      "scan_header_bytes": 4096,
      "max_memory_scan_count": 200,
      "default_max_turns": 500,
      "default_temperature": 1,
      "min_subagent_max_turns": 200,
      "memory_import_min_chars": 20,
      "memory_extraction_max_turns": 5
    },
    "skills": {
      "skill_manage_output_max": 30000,
      "skill_manage_list_max": 30,
      "skill_manage_dir_entry_max": 100,
      "registry_filename": "agent-created-skills.json"
    },
    "cron": {
      "cron_expiry_ms": 259200000,
      "scheduler_tick_ms": 500,
      "lock_retry_ms": 5000,
      "max_scheduled_jobs": 50,
      "default_loop_interval": "10m",
      "scheduled_tasks_file": "scheduled_tasks.json",
      "scheduled_tasks_lock": "scheduled_tasks.lock",
      "loop_job_marker_prefix": "[/loop:",
      "default_jitter_config": {
        "recurringFrac": 0.1,
        "recurringCapMs": 900000,
        "oneShotMaxMs": 90000,
        "oneShotFloorMs": 0,
        "oneShotMinuteMod": 30
      }
    }
  },

  "enums": {
    "permission_mode": ["default", "acceptEdits", "plan", "auto", "dontAsk", "bypassPermissions", "fullAccess", "ignore", "work", "delegate"],
    "risk_level": ["safe", "low", "medium", "high", "critical"],
    "risk_priority": { "safe": 0, "low": 1, "medium": 2, "high": 3, "critical": 4 },
    "model_variant_types": ["lite", "builtin-lite", "reasoning", "vision", "longContext", "subagent"],
    "valid_reasoning_efforts": ["minimal", "low", "medium", "high", "xhigh", "max"],
    "model_trust_level": ["unverified", "custom", "certified"],
    "memory_scope": ["managed", "user", "project", "project-local"],
    "memory_type": ["always", "manual"],
    "sandbox_verdict": ["auto-approve", "needs-approval", "block-listed"],
    "approval_decision": ["allow_once", "allow_session", "deny"],
    "system_tool_policy": ["disabled", "always_confirm", "auto_execute"],
    "file_action_mask": { "read": 1, "write": 2, "delete": 4 },
    "classifier_behavior": ["allow", "deny", "denialLimitExceeded", "transcriptTooLong", "fallback", "failClosed"],
    "tool_permission_type": ["Read", "Bash", "Edit", "Unknown"]
  },

  "data_formats": {
    "item_types": ["message", "reasoning", "function_call", "function_call_result", "file-history-snapshot", "ai-title", "resend-fork-notice"],
    "custom_input_item_types": ["custom-title", "ai-title", "file-history-snapshot", "summary", "topic", "goal-result", "goal-progress", "resend-fork-notice"],
    "session_disk_layout": {
      "projects/{compressPath(cwd)}/{sessionId}.jsonl": "对话转录（append-only）",
      "projects/{compressPath(cwd)}/{sessionId}.meta.json": "会话元数据",
      "projects/{compressPath(cwd)}/{parentSessionId}/subagents/agent-{xxx}.jsonl": "子 agent 转录",
      "file-history/{sessionId}/{pathHash}@v{N}": "文件版本备份",
      "file-tree-manifests/{sessionId}.json": "文件树清单",
      "traces/{pid}/trace_{uuid}.json": "OTel 风格 trace",
      "sessions/{port}.json": "daemon 注册表"
    },
    "cron_task": {
      "fields": ["id(8位hex)", "cron", "prompt", "createdAt", "recurring?", "durable?", "lastFiredAt?", "permanent?"],
      "id_derivation": "randomUUID().slice(0,8)"
    },
    "pipeline_state_yaml_schema_version": 1,
    "pipeline_log_fields": ["request_id", "entry", "stage", "intent_length", "has_existing_doc", "context_signals", "route", "decision_path", "target_skill", "fallback", "stage_skipped", "duration_ms"],
    "pipeline_decision_path": ["context_signal", "intent_analysis", "clarification", "environment_detect", "user_confirmation"]
  },

  "safe_command_whitelist": ["ls","dir","pwd","cd","echo","cat","more","less","head","tail","grep","find","cp","mv","mkdir","touch","chmod","chown","df","du","ps","top","which","where","type","file","stat","wc","sort","uniq","diff","patch","tee","xargs","env","printenv","uname","whoami","hostname","date","cal","bc","expr","jq","yq","sed","awk","cut","tr","column","tar","zip","unzip","gzip","gunzip","bzip2","curl","wget","ssh","scp","rsync","npm","node","git","python","python3","pip","pip3","java","javac","mvn","gradle","go","cargo","rustc","gcc","g++","make","cmake","dotnet","swift","swiftc","pnpm","bun","deno","tsx","ts-node","npx","yarn","lerna","turbo","nx","docker","kubectl","terraform","ansible","podman","jest","mocha","vitest","pytest","phpunit","eslint","prettier","tsc","swc","gh","glab"],

  "default_safety_filter_rules": [
    { "pathPattern": "~/.ssh/", "level": "high" },
    { "pathPattern": "~/.aws/", "level": "high" },
    { "pathPattern": "~/.gcp/", "level": "high" },
    { "pathPattern": "~/.gnupg/", "level": "high" },
    { "pathPattern": "~/.gpg/", "level": "high" },
    { "pathPattern": "~/.azure/", "level": "high" },
    { "pathPattern": "~/.config/gcloud/", "level": "high" },
    { "pathPattern": "~/.kube/config", "level": "high" },
    { "pathPattern": "~/.docker/config.json", "level": "high" },
    { "pathPattern": "~/.docker/daemon.json", "level": "high" },
    { "pathPattern": "~/.netrc", "level": "high" },
    { "pathPattern": "~/.npmrc", "level": "high" },
    { "pathPattern": "~/.pypirc", "level": "high" },
    { "pathPattern": "~/.gem/credentials", "level": "high" },
    { "pathPattern": "~/.config/gh/hosts.yml", "level": "high" },
    { "pathPattern": "~/.git-credentials", "level": "high" },
    { "pathPattern": "~/.terraform.d/credentials.tfrc.json", "level": "high" },
    { "pathPattern": "~/library/keychains/", "level": "high" },
    { "pathPattern": "~/Library/Application Support/CodeBuddyExtension/Data/Public/auth/", "level": "high" },
    { "pathPattern": "~/AppData/Local/CodeBuddyExtension/Data/Public/auth/", "level": "high" },
    { "pathPattern": "~/.local/share/CodeBuddyExtension/Data/Public/auth/", "level": "high" },
    { "pathPattern": "~/.codebuddy/settings.json", "level": "high" },
    { "pathPattern": "~/.codebuddy/settings.local.json", "level": "high" },
    { "pathPattern": "~/.workbuddy/settings.json", "level": "high" },
    { "pathPattern": "~/.workbuddy/settings.local.json", "level": "high" }
  ],

  "build_order": [
    { "step": 1, "topic": "Agent 循环引擎 + RunState + item 协议 + SessionStore（JSONL 追加写 + lastMessageId 回退指针）", "ref": "01 §1-§3", "dependency": [] },
    { "step": 2, "topic": "工具系统 + 权限分级（10 模式、shouldAutoApprove、审批记忆）+ 沙箱分类器（CommandUtils 正则表、classifySafety、敏感路径）", "ref": "01 §2 + 02 §1-§4", "dependency": [1] },
    { "step": 3, "topic": "模型调度（MODEL_VARIANT_TYPES + computeRelatedModel fallback 链 + configureModelConfig）", "ref": "03 第一部分", "dependency": [1] },
    { "step": 4, "topic": "记忆架构（规则文件 + Agent 持久记忆 + 相关记忆 + 提取子 agent）+ 技能系统（SKILL.md 发现/解析 + skill_manage）", "ref": "03 第二、三部分", "dependency": [3] },
    { "step": 5, "topic": "Cron 自动化（解析器→StateManager→Storage→createCronScheduler→SchedulerService→工具 + /loop）", "ref": "04 第二部分", "dependency": [1] },
    { "step": 6, "topic": "文档管线（tencent-docx 三段流水线 + 溯源协议 + 下游技能）", "ref": "04 第一部分", "dependency": [1, 4] },
    { "step": 7, "topic": "auto-mode 两阶段分类器（最复杂，依赖模型服务，先 mock fail-closed 占位再替换真模型）", "ref": "02 §5", "dependency": [2, 3] }
  ],

  "must_preserve_semantics": [
    "item 追加写 + lastMessageId 指针回退（历史永不删除）",
    "parentId 树状链（消息分组/分叉/重放全依赖）",
    "providerData 侧车（模型无关数据与模型数据严格分离）",
    "turn 中断恢复游标（_currentTurnInProgress + _currentTurnPersistedItemCount）",
    "权限与沙箱双层判定，互不越权",
    "fail-closed：未知/不可用/超时 → 一律按拦截处理",
    "HIGH/CRITICAL 永不自动放行，即使 bypass/fullAccess",
    "审批记忆只存会话级，键 = 规范化命令 + cwd",
    "模型 fallback 链永远有主模型兜底，custom/external 跳过默认关联",
    "记忆单一事实源是文件系统，append-only + 去重",
    "三阶段合法链（S1→S2→S3，S1 必经 S2，链必终于 S3），只有最终 docx 才对外可见",
    "Cron 三态：一次性触发即删 / 递归 3 天过期 / durable 跨重启"
  ]
}
